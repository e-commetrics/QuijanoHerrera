# cPanel / Apache configuration for the static export.
# Next.js cannot set headers in a static export, so they live here.
# This file is copied into /out by `next build`.

# --- Pretty URLs: /derecho-civil/ is served from derecho-civil/index.html ---
DirectoryIndex index.html
Options -Indexes

# --- Custom 404 (Next generates /404.html) ---
ErrorDocument 404 /404.html

# --- HTTPS + canonical host -------------------------------------------------
# Uncomment once the SSL certificate is active and the preferred host is set.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# --- Compression ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------------------
# Build assets under /_next/static are content-hashed, so they can be cached for
# a year. Images in /img keep stable file names, so they get a shorter lifetime
# (a replaced photo shows up within a month at most).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
