# Copy this file to `.env` and adjust. `.env` is never committed.
#
# NEXT_PUBLIC_ variables are embedded in the public JavaScript/HTML at build
# time: only put public values here, never keys or passwords.

# Public URL of the production site, without a trailing slash. Used for
# canonical URLs, sitemap.xml, robots.txt, Open Graph and schema.org data.
# Must be correct BEFORE running `pnpm build` (static export bakes it in).
NEXT_PUBLIC_SITE_URL=https://quijanoherrera.mx
